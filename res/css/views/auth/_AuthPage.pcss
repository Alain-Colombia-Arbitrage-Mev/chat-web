.mx_AuthPage {
    width: 100%;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    background-color: $authpage-bg-color;
    height: 100vh;
    overflow: auto;
}

.mx_AuthPage_modal {
    display: flex;
    margin: 60px auto auto;
    border-radius: 8px;
    box-shadow: 0 4px 20px 0 rgba(0, 0, 0, 0.15);
    background-color: $authpage-modal-bg-color;
    max-width: 800px;
    width: 90%;

    @media only screen and (max-height: 768px) {
        margin-top: 30px;
        width: 95%;
    }

    @media only screen and (max-width: 768px) {
        margin-top: 20px;
        width: 95%;
        max-width: 600px;
    }

    @media only screen and (max-width: 480px) {
        margin: 10px auto auto;
        width: 98%;
        max-width: none;
        border-radius: 12px;
    }

    @media only screen and (max-width: 320px) {
        margin: 5px auto auto;
        width: 100%;
        border-radius: 8px;
    }
}

/* Imagen flotante decorativa */
.mx_AuthPage_floatingImage {
    position: fixed;
    bottom: 25px;
    right: 25px;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    animation: authFloatIn 2.5s ease-out 1.5s forwards;
}

.mx_AuthPage_floatingImage_svg {
    width: 180px;
    height: auto;
    filter: drop-shadow(0 4px 20px rgba(0, 0, 0, 0.25));
    animation: authGentleFloat 7s ease-in-out infinite;
}

@keyframes authFloatIn {
    0% {
        opacity: 0;
        transform: translateY(40px) translateX(40px) scale(0.8);
    }
    100% {
        opacity: 0.8;
        transform: translateY(0) translateX(0) scale(1);
    }
}

@keyframes authGentleFloat {
    0%, 100% {
        transform: translateY(0px) rotate(0deg);
    }
    25% {
        transform: translateY(-8px) rotate(1deg);
    }
    50% {
        transform: translateY(-12px) rotate(0deg);
    }
    75% {
        transform: translateY(-8px) rotate(-1deg);
    }
}

/* Responsive design para imagen flotante */
@media only screen and (max-width: 768px) {
    .mx_AuthPage_floatingImage {
        bottom: 20px;
        right: 20px;
    }

    .mx_AuthPage_floatingImage_svg {
        width: 150px;
    }
}

@media only screen and (max-width: 480px) {
    .mx_AuthPage_floatingImage {
        bottom: 15px;
        right: 15px;
    }

    .mx_AuthPage_floatingImage_svg {
        width: 120px;
    }
}

@media only screen and (max-width: 320px) {
    .mx_AuthPage_floatingImage {
        bottom: 12px;
        right: 12px;
    }

    .mx_AuthPage_floatingImage_svg {
        width: 100px;
    }
}
