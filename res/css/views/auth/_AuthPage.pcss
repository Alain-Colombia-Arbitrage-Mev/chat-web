.mx_AuthPage {
    width: 100%;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: $authpage-bg-color;
    height: 100vh;
    overflow: auto;
    padding: 20px;
    box-sizing: border-box;
}

.mx_AuthPage_container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    max-width: 100%;
    margin-top: 20px;
}

.mx_AuthPage_modal {
    display: flex;
    margin: 0;
    border-radius: 8px;
    box-shadow: 0 4px 20px 0 rgba(0, 0, 0, 0.15);
    background-color: $authpage-modal-bg-color;
    max-width: 800px;
    width: 90%;
}

@media only screen and (max-height: 768px) {
    .mx_AuthPage_modal {
        margin: 0;
        width: 95%;
    }
}

@media only screen and (max-width: 768px) {
    .mx_AuthPage {
        padding: 15px;
    }

    .mx_AuthPage_container {
        gap: 10px;
        margin-top: 15px;
    }

    .mx_AuthPage_modal {
        margin: 0;
        width: 95%;
        max-width: 600px;
    }
}

@media only screen and (max-width: 480px) {
    .mx_AuthPage {
        padding: 10px;
    }

    .mx_AuthPage_container {
        gap: 8px;
        margin-top: 12px;
    }

    .mx_AuthPage_modal {
        margin: 0;
        width: 98%;
        max-width: none;
        border-radius: 12px;
    }
}

@media only screen and (max-width: 320px) {
    .mx_AuthPage {
        padding: 8px;
    }

    .mx_AuthPage_container {
        gap: 6px;
        margin-top: 8px;
    }

    .mx_AuthPage_modal {
        margin: 0;
        width: 100%;
        border-radius: 8px;
    }
}

/* Imagen flotante decorativa */
.mx_AuthPage_floatingImage {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    animation: authFloatIn 2s ease-out 1s forwards;
}

.mx_AuthPage_floatingImage_svg {
    width: 200px;
    height: auto;
    filter: drop-shadow(0 3px 15px rgba(0, 0, 0, 0.3));
    animation: authGentleFloat 4s ease-in-out infinite;
    transition: transform 0.3s ease;
}

@keyframes authFloatIn {
    0% {
        opacity: 0;
        transform: translateY(30px) translateX(30px) scale(0.7);
    }
    100% {
        opacity: 0.9;
        transform: translateY(0) translateX(0) scale(1);
    }
}

@keyframes authGentleFloat {
    0%, 100% {
        transform: translateY(0px) rotate(0deg);
    }
    25% {
        transform: translateY(-15px) rotate(2deg);
    }
    50% {
        transform: translateY(-20px) rotate(0deg);
    }
    75% {
        transform: translateY(-15px) rotate(-2deg);
    }
}

/* Responsive design para imagen flotante */
@media only screen and (max-width: 768px) {
    .mx_AuthPage_floatingImage {
        bottom: 15px;
        right: 15px;
    }

    .mx_AuthPage_floatingImage_svg {
        width: 150px;
    }
}

@media only screen and (max-width: 480px) {
    .mx_AuthPage_floatingImage {
        bottom: 12px;
        right: 12px;
    }

    .mx_AuthPage_floatingImage_svg {
        width: 120px;
    }
}

@media only screen and (max-width: 320px) {
    .mx_AuthPage_floatingImage {
        bottom: 10px;
        right: 10px;
    }

    .mx_AuthPage_floatingImage_svg {
        width: 100px;
    }
}
